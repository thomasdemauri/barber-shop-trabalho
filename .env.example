NODE_ENV=development

POSTGRES_DB=barbershop
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
BACKEND_PORT=3000
FRONTEND_PORT=5173

VITE_PROD=false
VITE_API_URL=http://localhost:3000/api
BACKEND_INTERNAL_URL=http://backend:3000

RABBITMQ_USER=barbershop
RABBITMQ_PASSWORD=replace-with-a-local-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

SHOP_TIMEZONE=America/Sao_Paulo
SLOT_INTERVAL_MINUTES=30
SEED_DEMO_DATA=true

# Notification worker
# memory = simulated (logged only) | brevo = real sending (BREVO_API_KEY from app.brevo.com; EMAIL_FROM must be a verified Brevo sender)
EMAIL_PROVIDER=memory
EMAIL_FROM=Navalha de Ouro <nao-responda@barbearia.test>
BREVO_API_KEY=
SHOP_NAME=Navalha de Ouro
FRONTEND_URL=http://localhost:5173
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_MS=2000
