DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbershop?schema=public"
JWT_SECRET="change-this-in-production"
PORT=3333
CORS_ORIGIN="http://localhost:5173"
RABBITMQ_URL="amqp://barbershop:barbershop@localhost:5672"
# Wall-clock zone of the shop: working hours such as "08:00" are interpreted in it.
SHOP_TIMEZONE="America/Sao_Paulo"
# Minutes between bookable start times.
SLOT_INTERVAL_MINUTES=30
# Seeds demo clients and appointments (prisma/DEMO_USERS.md). Development only.
SEED_DEMO_DATA=false

# Notification worker (npm run worker)
# memory = simulated (logged only) | brevo = real sending (BREVO_API_KEY from app.brevo.com; EMAIL_FROM must be a verified Brevo sender)
EMAIL_PROVIDER=memory
EMAIL_FROM="Navalha de Ouro <nao-responda@barbearia.test>"
BREVO_API_KEY=
SHOP_NAME="Navalha de Ouro"
FRONTEND_URL="http://localhost:5173"
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_MS=2000
